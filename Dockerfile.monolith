#
# EduCollab single-image (monolith) Dockerfile
#
# One container runs:
# - MariaDB (as MySQL replacement)
# - Spring Boot backend
# - Hocuspocus collab server
# - Nginx (serves frontend + reverse proxies /api, /git, /collab)
#

############################
# Backend build
############################
FROM maven:3.9.9-eclipse-temurin-21 AS backend-build
WORKDIR /src
COPY backend/pom.xml backend/pom.xml
RUN --mount=type=cache,target=/root/.m2 \
    cd backend && mvn -q -DskipTests dependency:go-offline
COPY backend/src backend/src
RUN --mount=type=cache,target=/root/.m2 \
    cd backend && mvn -q -DskipTests package

############################
# Frontend build
############################
FROM node:20-alpine AS frontend-build
WORKDIR /src
ARG VITE_API_BASE_URL=
ARG VITE_COLLAB_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_COLLAB_BASE_URL=${VITE_COLLAB_BASE_URL}
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci
COPY frontend frontend
RUN cd frontend && npm run build

############################
# Collab build (debian/glibc)
############################
FROM node:20-bookworm-slim AS collab-build
WORKDIR /src
COPY collab-server/package*.json collab-server/
RUN cd collab-server && npm ci --omit=dev
COPY collab-server/src collab-server/src

############################
# Java runtime (copy only)
############################
FROM eclipse-temurin:21-jre AS java-runtime

############################
# Final image
############################
FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      mariadb-server \
      mariadb-client \
      nginx \
      supervisor \
      tini \
    && rm -rf /var/lib/apt/lists/*

# Avoid default site config conflicts; we provide our own in conf.d.
RUN rm -f /etc/nginx/sites-enabled/default || true

# Copy Java 21 runtime from Temurin image.
COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

# Backend artifacts
COPY --from=backend-build /src/backend/target/*.jar /app/backend/app.jar
COPY backend/src/main/resources/schema.sql /app/backend/schema.sql

# Collab artifacts
COPY --from=collab-build /src/collab-server /app/collab

# Frontend dist
COPY --from=frontend-build /src/frontend/dist /usr/share/nginx/html

# Configs + scripts
COPY docker/monolith/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/monolith/supervisord.conf /etc/supervisor/conf.d/educollab.conf
COPY docker/monolith/entrypoint.sh /usr/local/bin/educollab-entrypoint.sh
RUN chmod +x /usr/local/bin/educollab-entrypoint.sh

# Persistent app data (uploads/repos/collab) + DB
VOLUME ["/app/data", "/var/lib/mysql"]

EXPOSE 80

ENTRYPOINT ["/usr/bin/tini","--","/usr/local/bin/educollab-entrypoint.sh"]
